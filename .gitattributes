# Texto normalizado para LF no repositório, qualquer que seja o sistema de
# quem faz o commit.
* text=auto

# O run.sh roda no bash (inclusive WSL e Git Bash): com CRLF ele quebra.
*.sh text eol=lf
# O run.ps1 roda no PowerShell, que prefere CRLF.
*.ps1 text eol=crlf

*.png binary
*.pdf binary
*.epub binary
