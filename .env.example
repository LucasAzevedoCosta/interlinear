# Copie para .env, ao lado do compose.yaml, e preencha só o que for usar.
# O .env está no .gitignore: as chaves nunca entram no repositório.
# Todas as variáveis estão explicadas em docs/configuracao.md.

# --- Imagem ---------------------------------------------------------------
# latest (padrão) ou claude, a imagem que já traz o Claude Code.
INTERLINEAR_IMAGE_TAG=latest
# Construindo do código (docker compose up -d --build): 1 inclui o Claude Code.
INTERLINEAR_WITH_CLAUDE=0

# --- Rede -----------------------------------------------------------------
INTERLINEAR_PORT=8000
# Nomes extras aceitos no Host, separados por vírgula. Só para expor na rede.
INTERLINEAR_ALLOWED_HOSTS=

# --- Chaves de API (opcionais) ---------------------------------------------
# Definidas aqui, têm prioridade sobre as salvas pela tela e não vão para disco.
INTERLINEAR_OPENAI_KEY=
INTERLINEAR_ANTHROPIC_KEY=
INTERLINEAR_GOOGLE_KEY=
INTERLINEAR_COMPAT_KEY=

# --- IA local, rodando no seu computador fora do container -----------------
INTERLINEAR_OLLAMA_URL=http://host.docker.internal:11434/v1
INTERLINEAR_LMSTUDIO_URL=http://host.docker.internal:1234/v1

# --- Diagnóstico e OCR -----------------------------------------------------
INTERLINEAR_LOG_LEVEL=INFO
INTERLINEAR_OCR_LANGS=por+eng
